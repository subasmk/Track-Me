<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="TrackMe"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Standard Flutter launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Lets home_widget attach a Uri (trackme://goal?id=...) to the
              PendingIntent it puts on each widget, so tapping a specific
              goal's widget can carry data back into the app. See
              TrackMeGoalWidgetProvider.kt and main.dart's widget-tap
              handling.
            -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>
        </activity>

        <!--
          Single-goal widget (Small + Medium sizes in the picker). Each
          placed instance is bound to one goal via WidgetConfigureActivity
          below, so a user can add several of these side by side — one per
          goal — exactly like separate Duolingo streak widgets.
        -->
        <receiver
            android:name=".TrackMeGoalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trackme_goal_widget_info" />
        </receiver>

        <!--
          Multi-goal overview widget (Large size in the picker). Not
          per-goal configurable — always shows the top goals sorted by
          streak plus an overall "today" completion count.
        -->
        <receiver
            android:name=".TrackMeOverviewWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trackme_overview_widget_info" />
        </receiver>

        <!--
          Quest overview widget — shows today's quest completion count and
          the top active quest. Tapping opens the app's quest screen.
        -->
        <receiver
            android:name=".TrackMeQuestWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trackme_quest_widget_info" />
        </receiver>

        <!--
          Native (non-Flutter) picker shown once, right when a user drags
          the single-goal widget onto their home screen, so they can choose
          which goal that particular widget instance tracks. Deliberately
          plain Android views rather than a Flutter screen — configure
          activities need to appear instantly, without booting a Flutter
          engine.
        -->
        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/WidgetConfigureTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below. This is used by the Flutter tool
             to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
