<?xml version="1.0" encoding="utf-8"?>
<!-- Quest widget in the in-app Quests (Solo Leveling system) style.
     RemoteViews-safe: FrameLayout, LinearLayout, TextView, ImageView only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sys_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sys_panel">

    <ImageView
        android:id="@+id/sys_br_tl_h"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_tl_v"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_tr_h"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_gravity="top|end"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_tr_v"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_bl_h"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|start"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_bl_v"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_br_h"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/sys_bracket_cyan" />
    <ImageView
        android:id="@+id/sys_br_br_v"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/sys_bracket_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/sys_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sys_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_sys_icon"
                android:gravity="center"
                android:textSize="20sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/sys_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:shadowColor="#CC3FD4FF"
                    android:shadowRadius="8"
                    android:textColor="#FFE6F7FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/sys_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:textColor="#FF7FA9C7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/sys_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:textColor="#FFFFD166"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sys_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF7FA9C7"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sys_row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/sys_row0_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6F7FF"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sys_row0_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#FF8BE6FF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/sys_row0_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sys_check">
                <ImageView
                    android:id="@+id/sys_row0_tick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:src="@drawable/ic_sys_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sys_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/sys_row1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6F7FF"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sys_row1_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#FF8BE6FF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/sys_row1_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sys_check">
                <ImageView
                    android:id="@+id/sys_row1_tick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:src="@drawable/ic_sys_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sys_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/sys_row2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6F7FF"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sys_row2_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#FF8BE6FF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/sys_row2_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sys_check">
                <ImageView
                    android:id="@+id/sys_row2_tick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:src="@drawable/ic_sys_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sys_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/sys_row3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6F7FF"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sys_row3_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#FF8BE6FF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/sys_row3_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sys_check">
                <ImageView
                    android:id="@+id/sys_row3_tick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:src="@drawable/ic_sys_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
