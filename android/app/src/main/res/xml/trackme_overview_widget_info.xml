<?xml version="1.0" encoding="utf-8"?>
<!--
  No android:configure here — unlike the single-goal widget, this one
  always shows the user's own top goals automatically, so there's nothing
  to ask the user to pick.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="600dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="140dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_overview"
    android:description="@string/overview_widget_label">
</appwidget-provider>
